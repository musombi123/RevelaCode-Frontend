# RevelaCode SPA routing and deployment-safe asset caching.
<IfModule mod_headers.c>
  <FilesMatch "^(index\\.html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\\.(js|mjs|css|woff2?|ttf|svg|png|jpe?g|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Never rewrite a missing hashed asset to index.html; return a real 404.
  RewriteCond %{REQUEST_URI} ^/assets/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ - [R=404,L]

  # Keep API/backend paths outside the SPA fallback.
  RewriteCond %{REQUEST_URI} ^/(api|support)/
  RewriteRule ^ - [L]

  # Serve real files and directories normally, then use the SPA shell.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>
