{
  "appId": "com.revelacode.app",
  "appName": "RevelaCode",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 900,
      "launchFadeOutDuration": 180,
      "backgroundColor": "#08111F",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_INSIDE",
      "showSpinner": false
    }
  }
}