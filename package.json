{
  "name": "revelacode-frontend",
  "version": "1.0.2",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "vision:assets": "node scripts/fetch-free-vision-assets.mjs",
    "test:auth": "node --test tests/token-storage.test.mjs tests/session-identity.test.mjs tests/start-modal-jwt.test.mjs tests/privileged-workspaces.test.mjs",
    "test:community": "node --test tests/community-comments.test.mjs",
    "test:platform-host": "node --test tests/platform-host.test.mjs",
    "test:demo": "node --test tests/demo-session.test.mjs",
    "test:offline-ai": "node --test tests/offline-ai.test.mjs tests/revelaai-offline-session.test.mjs",
    "test:jumuiya-samples": "node --test tests/admin-jumuiya-samples.test.mjs",
    "test:staff-invitations": "node --test tests/jumuiya-staff-invitations.test.mjs",
    "test:revelaai-workspace": "node --test tests/revelaai-workspace-integration.test.mjs tests/revelaai-artifact-cards.test.mjs tests/revelaai-workspace-intent.test.mjs tests/revelaai-code-ide.test.mjs",
    "build:nexora": "vite build apps/nexora --config apps/nexora/vite.config.js",
    "build:web": "npm run build:nexora && npm run build && node scripts/verify-nexora-static-output.mjs",
    "test:studio-library": "node --test tests/revelaai-studio-library.test.mjs",
    "test:capacitor": "node --test tests/capacitor-plugin-registry.test.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@capacitor-community/admob": "8.3.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@uiw/react-codemirror": "^4.25.12",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.284.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.5.2",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.0",
    "remark-gfm": "^4.0.1",
    "shadcn-ui": "^0.9.5",
    "tailwind-merge": "^3.4.0",
    "@capacitor/app": "^8.1.2",
    "@capgo/capacitor-speech-recognition": "^8.5.1",
    "@capgo/capacitor-speech-synthesis": "^8.0.27",
    "@codemirror/lang-css": "^6.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.14",
    "postcss": "^8.4.24",
    "rollup": "^4.17.0",
    "tailwindcss": "^3.4.1",
    "vite": "^6.0.0"
  }
}
